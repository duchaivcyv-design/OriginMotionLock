<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>items</key>
    <array>
        <!-- Tiêu đề chính và Công tắc Bật/Tắt Tweak -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Cài đặt chung OriginMotionLock</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.yourname.originmotionlock</string>
            <key>key</key>
            <string>isEnabled</string>
            <key>label</key>
            <string>Kích hoạt Tweak</string>
            <key>PostNotification</key>
            <string>com.yourname.originmotionlock/prefsupdated</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.yourname.originmotionlock</string>
            <key>key</key>
            <string>enableParallax</string>
            <key>label</key>
            <string>Bật hiệu ứng Parallax</string>
            <key>PostNotification</key>
            <string>com.yourname.originmotionlock/prefsupdated</string>
        </dict>

        <!-- Nhóm Tùy chỉnh cảm biến và hướng -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Tùy chỉnh hướng chuyển động (Axis)</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <false/>
            <key>defaults</key>
            <string>com.yourname.originmotionlock</string>
            <key>key</key>
            <string>invertX</string>
            <key>label</key>
            <string>Đảo ngược trục X (Roll)</string>
            <key>PostNotification</key>
            <string>com.yourname.originmotionlock/prefsupdated</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <false/>
            <key>defaults</key>
            <string>com.yourname.originmotionlock</string>
            <key>key</key>
            <string>invertY</string>
            <key>label</key>
            <string>Đảo ngược trục Y (Pitch)</string>
            <key>PostNotification</key>
            <string>com.yourname.originmotionlock/prefsupdated</string>
        </dict>

        <!-- Nhóm Tối ưu hóa hiệu năng -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Hiệu năng và Tiết kiệm pin</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.yourname.originmotionlock</string>
            <key>key</key>
            <string>lowPowerModeOptimize</string>
            <key>label</key>
            <string>Tự tắt khi bật Tiết kiệm pin</string>
            <key>PostNotification</key>
            <string>com.yourname.originmotionlock/prefsupdated</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.yourname.originmotionlock</string>
            <key>key</key>
            <string>useCoreMotion</string>
            <key>label</key>
            <string>Sử dụng CoreMotion Manager</string>
            <key>PostNotification</key>
            <string>com.yourname.originmotionlock/prefsupdated</string>
        </dict>

        <!-- Nhóm Điều chỉnh thông số khoảng cách & độ nhạy -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Thông số kỹ thuật & Khoảng cách</string>
            <key>footerText</key>
            <string>Tùy chỉnh độ lệch tối đa, hệ số thu phóng và độ mượt của chuyển động cảm biến trên màn hình khóa.</string>
        </dict>
        
        <!-- Khoảng cách lệch tối đa (Max Offset) -->
        <dict>
            <key>cell</key>
            <string>PSStaticTextCell</string>
            <key>label</key>
            <string>Độ lệch tối đa (Max Offset)</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>default</key>
            <real>15.0</real>
            <key>defaults</key>
            <string>com.yourname.originmotionlock</string>
            <key>key</key>
            <string>maxOffsetValue</string>
            <key>min</key>
            <real>1.0</real>
            <key>max</key>
            <real>50.0</real>
            <key>showValue</key>
            <true/>
            <key>PostNotification</key>
            <string>com.yourname.originmotionlock/prefsupdated</string>
        </dict>

        <!-- Hệ số thu phóng khung hình (Scale Value) -->
        <dict>
            <key>cell</key>
            <string>PSStaticTextCell</string>
            <key>label</key>
            <string>Hệ số thu phóng (Scale)</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>default</key>
            <real>1.2</real>
            <key>defaults</key>
            <string>com.yourname.originmotionlock</string>
            <key>key</key>
            <string>scaleValue</string>
            <key>min</key>
            <real>1.0</real>
            <key>max</key>
            <real>2.0</real>
            <key>showValue</key>
            <true/>
            <key>PostNotification</key>
            <string>com.yourname.originmotionlock/prefsupdated</string>
        </dict>

        <!-- Độ nhạy trục X -->
        <dict>
            <key>cell</key>
            <string>PSStaticTextCell</string>
            <key>label</key>
            <string>Độ nhạy trục X</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>default</key>
            <real>1.0</real>
            <key>defaults</key>
            <string>com.yourname.originmotionlock</string>
            <key>key</key>
            <string>sensitivityX</string>
            <key>min</key>
            <real>0.1</real>
            <key>max</key>
            <real>3.0</real>
            <key>showValue</key>
            <true/>
            <key>PostNotification</key>
            <string>com.yourname.originmotionlock/prefsupdated</string>
        </dict>

        <!-- Độ nhạy trục Y -->
        <dict>
            <key>cell</key>
            <string>PSStaticTextCell</string>
            <key>label</key>
            <string>Độ nhạy trục Y</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>default</key>
            <real>1.0</real>
            <key>defaults</key>
            <string>com.yourname.originmotionlock</string>
            <key>key</key>
            <string>sensitivityY</string>
            <key>min</key>
            <real>0.1</real>
            <key>max</key>
            <real>3.0</real>
            <key>showValue</key>
            <true/>
            <key>PostNotification</key>
            <string>com.yourname.originmotionlock/prefsupdated</string>
        </dict>

        <!-- Thông tin tác giả / Phiên bản -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Thông tin</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSStaticTextCell</string>
            <key>label</key>
            <string>Phiên bản</string>
            <key>subtitle</key>
            <string>1.0.0</string>
        </dict>
    </array>
    <key>title</key>
    <string>OriginMotionLock</string>
</dict>
</plist>
