<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.private.security.platform-application</key>
    <true/>
    <key>com.apple.private.security.no-sandbox</key>
    <true/>
    <key>com.apple.security.get-task-allow</key>
    <true/>
    <key>get-task-allow</key>
    <true/>
    <key>task_for_pid-allow</key>
    <true/>
    <key>run-unsigned-code</key>
    <true/>
    <key>keyproc_info-allow</key>
    <true/>
    <key>com.apple.private.security.storage.AppBundleLocal</key>
    <true/>
    <key>com.apple.private.security.storage.AppDataContainer</key>
    <true/>
    <key>com.apple.private.persona-mgmt</key>
    <true/>
    <!-- Tối ưu chống crash đồ họa và phân vùng hệ thống -->
    <key>com.apple.security.iokit-user-client-class</key>
    <array>
        <string>AGXDeviceUserClient</string>
        <string>IOHIDControllerUserClient</string>
        <string>IOSurfaceHostUserClient</string>
    </array>
</dict>
</plist>
