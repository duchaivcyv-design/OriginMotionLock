<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>items</key>
    <array>
        <!-- Nhóm 1: Trung tâm điều khiển cốt lõi -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Trung tâm Điều khiển Cốt lõi</string>
            <key>footerText</key>
            <string>Kích hoạt công tắc tổng để mở khóa toàn bộ hệ thống ẩn Sandbox và các thiết lập chuyên sâu bên dưới.</string>
        </dict>
        
        <!-- Công tắc tổng (Master Switch) -->
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.onyx.mbbypass</string>
            <key>key</key>
            <string>isEnabled</string>
            <key>label</key>
            <string>Kích hoạt Bypass Tổng</string>
        </dict>

        <!-- Nhóm 2: Liên kết đến bảng điều khiển chi tiết ứng dụng -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Quản lý Ứng dụng & Trò chơi</string>
            <key>footerText</key>
            <string>Chọn cấu hình chi tiết cho từng ứng dụng ngân hàng, ví điện tử và game.</string>
        </dict>
        
        <dict>
            <key>cell</key>
            <string>PSLinkCell</string>
            <key>detail</key>
            <string>MBBypassRootListController</string>
            <key>isController</key>
            <true/>
            <key>label</key>
            <string>Cấu hình Ứng dụng cụ thể</string>
        </dict>
    </array>
    <key>title</key>
    <string>MBBypass</string>
</dict>
</plist>
